include_guard(GLOBAL)
set(STORAGE_SYSTEMC_TARGET "" CACHE STRING "Existing SystemC target supplied by the host")
set(STORAGE_SYSTEMC_PREFIX "" CACHE PATH "Compatible standalone SystemC installation")
set(STORAGE_CXX_STANDARD 17 CACHE STRING "C++ standard matching the selected SystemC library")

if(STORAGE_SYSTEMC_TARGET AND STORAGE_SYSTEMC_PREFIX)
  message(FATAL_ERROR "Select either STORAGE_SYSTEMC_TARGET or STORAGE_SYSTEMC_PREFIX")
endif()
if(TARGET storage_systemc)
  if(STORAGE_SYSTEMC_PREFIX OR (STORAGE_SYSTEMC_TARGET AND NOT STORAGE_SYSTEMC_TARGET STREQUAL "storage_systemc"))
    message(FATAL_ERROR "Host already supplied storage_systemc; select that target only")
  endif()
  set(STORAGE_SYSTEMC_TARGET storage_systemc CACHE STRING "Host-supplied SystemC target" FORCE)
endif()
if(NOT TARGET storage_systemc)
  if(STORAGE_SYSTEMC_TARGET)
    if(NOT TARGET ${STORAGE_SYSTEMC_TARGET})
      message(FATAL_ERROR "Unknown SystemC target: ${STORAGE_SYSTEMC_TARGET}")
    endif()
    add_library(storage_systemc INTERFACE)
    target_link_libraries(storage_systemc INTERFACE ${STORAGE_SYSTEMC_TARGET})
    unset(STORAGE_SYSTEMC_INCLUDE CACHE)
    get_target_property(_storage_host_includes ${STORAGE_SYSTEMC_TARGET} INTERFACE_INCLUDE_DIRECTORIES)
    foreach(_include IN LISTS _storage_host_includes)
      if(EXISTS "${_include}/sysc/kernel/sc_ver.h")
        set(STORAGE_SYSTEMC_INCLUDE "${_include}" CACHE PATH "Host SystemC headers" FORCE)
        break()
      endif()
    endforeach()
  elseif(STORAGE_SYSTEMC_PREFIX)
    unset(STORAGE_SYSTEMC_INCLUDE CACHE)
    unset(STORAGE_SYSTEMC_LIBRARY CACHE)
    find_path(STORAGE_SYSTEMC_INCLUDE systemc HINTS "${STORAGE_SYSTEMC_PREFIX}/include" NO_DEFAULT_PATH REQUIRED)
    find_library(STORAGE_SYSTEMC_LIBRARY NAMES systemc HINTS "${STORAGE_SYSTEMC_PREFIX}/lib" "${STORAGE_SYSTEMC_PREFIX}/lib64" NO_DEFAULT_PATH REQUIRED)
    add_library(storage_systemc INTERFACE)
    target_include_directories(storage_systemc INTERFACE "${STORAGE_SYSTEMC_INCLUDE}")
    target_link_libraries(storage_systemc INTERFACE "${STORAGE_SYSTEMC_LIBRARY}" pthread)
  else()
    get_filename_component(SYSTEMC_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../axi_StorageStacked/third_party/systemc" ABSOLUTE)
    file(GLOB_RECURSE SYSTEMC_SOURCES CONFIGURE_DEPENDS "${SYSTEMC_ROOT}/src/sysc/*.cpp")
    list(FILTER SYSTEMC_SOURCES EXCLUDE REGEX "sc_cor_(pthread|fiber)\\.cpp$")
    add_library(storage_systemc STATIC ${SYSTEMC_SOURCES} "${SYSTEMC_ROOT}/src/sysc/qt/qt.c" "${SYSTEMC_ROOT}/src/sysc/qt/md/iX86_64.s")
    target_include_directories(storage_systemc PUBLIC "${SYSTEMC_ROOT}/src" PRIVATE "${SYSTEMC_ROOT}/src/sysc/qt")
    target_compile_definitions(storage_systemc PUBLIC SC_INCLUDE_FX SC_INCLUDE_DYNAMIC_PROCESSES)
    target_compile_options(storage_systemc PRIVATE -Wno-deprecated-declarations)
    set_target_properties(storage_systemc PROPERTIES CXX_STANDARD ${STORAGE_CXX_STANDARD} CXX_STANDARD_REQUIRED ON)
  endif()
endif()

if(STORAGE_SYSTEMC_TARGET AND NOT STORAGE_SYSTEMC_INCLUDE)
  get_target_property(_storage_host_includes ${STORAGE_SYSTEMC_TARGET} INTERFACE_INCLUDE_DIRECTORIES)
  foreach(_include IN LISTS _storage_host_includes)
    if(EXISTS "${_include}/sysc/kernel/sc_ver.h")
      set(STORAGE_SYSTEMC_INCLUDE "${_include}" CACHE PATH "Host SystemC headers" FORCE)
      break()
    endif()
  endforeach()
endif()
