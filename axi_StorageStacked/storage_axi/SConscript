Import('*')
import os
import runpy
storage_root = os.path.dirname(Dir('.').srcnode().abspath)
manifest = runpy.run_path(os.path.join(storage_root, 'scripts', 'storage_manifest.py'))['load'](storage_root)
link_defines = runpy.run_path(str(manifest['link_options']))['definitions']()
env.Append(CPPPATH=[Dir('#/src/systemc/ext'), *map(str, manifest['include_dirs'])])
# Give external source directories a build variant, so objects stay in gem5's cache.
# Source() still compiles the original .cpp files directly; no C++ include wrappers.
for group, sources in manifest['sources'].items():
    variants = {}
    for source in sources:
        if source.parent not in variants:
            variant = Dir('manifest/' + group + '/' + str(len(variants)))
            VariantDir(variant, str(source.parent), duplicate=0)
            variants[source.parent] = variant
        Source(variants[source.parent].File(source.name), append={'CPPDEFINES': link_defines})
memory_build = os.environ['MEMSIM_BUILD']
env.Append(LIBPATH=[memory_build], LIBS=['storagestacked_memsim'], RPATH=[memory_build])
