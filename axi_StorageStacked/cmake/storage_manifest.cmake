set(STORAGE_MANIFEST_FILE "${CMAKE_CURRENT_SOURCE_DIR}/storage_manifest.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${STORAGE_MANIFEST_FILE}")
file(READ "${STORAGE_MANIFEST_FILE}" STORAGE_MANIFEST_JSON)
string(JSON STORAGE_MANIFEST_VERSION GET "${STORAGE_MANIFEST_JSON}" version)
if(NOT STORAGE_MANIFEST_VERSION EQUAL 1)
  message(FATAL_ERROR "Unsupported storage manifest version")
endif()
function(storage_paths output)
  string(JSON size LENGTH "${STORAGE_MANIFEST_JSON}" ${ARGN})
  math(EXPR last "${size}-1")
  set(paths "")
  foreach(index RANGE 0 ${last})
    string(JSON relative GET "${STORAGE_MANIFEST_JSON}" ${ARGN} ${index})
    get_filename_component(absolute "${CMAKE_CURRENT_SOURCE_DIR}/${relative}" ABSOLUTE)
    if(NOT EXISTS "${absolute}")
      message(FATAL_ERROR "Missing storage path: ${absolute}")
    endif()
    list(APPEND paths "${absolute}")
  endforeach()
  set(${output} "${paths}" PARENT_SCOPE)
endfunction()
storage_paths(STORAGE_INCLUDE_DIRS include_dirs)
string(JSON size LENGTH "${STORAGE_MANIFEST_JSON}" sources)
math(EXPR last "${size}-1")
set(STORAGE_SOURCES "")
foreach(index RANGE 0 ${last})
  string(JSON group MEMBER "${STORAGE_MANIFEST_JSON}" sources ${index})
  storage_paths(group_sources sources ${group})
  list(APPEND STORAGE_SOURCES ${group_sources})
endforeach()
string(JSON relative GET "${STORAGE_MANIFEST_JSON}" memsim_source)
get_filename_component(STORAGE_MEMSIM_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/${relative}" ABSOLUTE)
