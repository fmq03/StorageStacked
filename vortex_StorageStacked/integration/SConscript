Import('*')
import os
import runpy
root = os.environ['STORAGE_STACK_ROOT']
manifest = runpy.run_path(os.path.join(root, 'scripts', 'storage_manifest.py'))['load'](root)
env.Append(CPPPATH=[Dir('#/src/systemc/ext'), *map(str, manifest['include_dirs'])])
link_defines = runpy.run_path(str(manifest['link_options']))['definitions']()
SimObject('StorageBridge.py', sim_objects=['StorageBridge'])
Source('axi_master.cc')
Source('storage.cc', append={'CPPDEFINES': link_defines})
